# Salin file ini menjadi .env lalu isi nilainya. File .env tidak boleh di-commit.
# Password database huruf+angka saja (tanpa karakter khusus), karena juga
# dipakai di dalam URL DATABASE_URL.

MYSQL_DATABASE=farmcare
MYSQL_USER=farmcare
MYSQL_PASSWORD=isiPasswordHurufAngka
MYSQL_ROOT_PASSWORD=isiRootPasswordHurufAngka

# Email untuk notifikasi perpanjangan sertifikat Let's Encrypt.
ACME_EMAIL=nama@email.com
