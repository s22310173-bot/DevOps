# Salin menjadi .env lalu isi nilainya. Jangan commit file .env.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=farmcare
DB_USER=farmcare
DB_PASS=ganti-password

# Hash dibuat dengan: php -r "echo password_hash('password', PASSWORD_DEFAULT);"
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=

# Opsional: lokasi file log audit (default: <app>/storage/logs)
# LOG_DIR=/var/www/html/devops/storage/logs
