Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Blokir akses langsung ke kode aplikasi, konfigurasi, dan dotfiles.
    RewriteRule ^app(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]

    # Biarkan file dan folder yang benar-benar ada (aset statis).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Selain itu arahkan ke front controller.
    RewriteRule ^ index.php [L]
</IfModule>
